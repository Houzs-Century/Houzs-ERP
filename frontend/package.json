{
  "name": "autocount-sync-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "node ../scripts/lint-ratchet.mjs",
    "lint:update": "node ../scripts/lint-ratchet.mjs --update",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:sw": "node scripts/check-service-worker.mjs",
    "check:raw-fetch": "node scripts/check-raw-fetch-inventory.mjs",
    "check:silent-writes": "node scripts/check-silent-writes.mjs",
    "check:test-focus": "node scripts/check-test-focus.mjs",
    "test:smoke-script": "node --test scripts/smoke-check.test.mjs",
    "dev:perf-lab": "vite --config perf-lab/vite.config.ts",
    "typecheck:perf-local": "tsc --noEmit -p perf-lab/tsconfig.json",
    "test:perf-local": "playwright test --config perf-lab/playwright.config.ts",
    "test:perf-local:list": "playwright test --config perf-lab/playwright.config.ts --list",
    "smoke": "node scripts/smoke-check.mjs",
    "deploy": "npm run build && wrangler pages deploy --commit-dirty=true",
    "dev:settlement-demo": "node demo/dev.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@types/leaflet": "^1.9.21",
    "@vis.gl/react-google-maps": "^1.9.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.20",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
