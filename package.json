{
  "name": "houzs-erp",
  "version": "2.0.0",
  "private": true,
  "description": "Houzs Century ERP — Cloudflare Workers backend + React/Vite frontend. Each sub-app (backend/, frontend/) has its own package.json and deploys itself.",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check:file-size:update": "node scripts/check-file-size.mjs --update",
    "check:file-size:list": "node scripts/check-file-size.mjs --list",
    "coverage:check": "node scripts/coverage-ratchet.mjs --check --report backend/coverage/light/coverage-final.json --report backend/coverage/workers/coverage-final.json --report frontend/coverage/coverage-final.json",
    "coverage:update": "node scripts/coverage-ratchet.mjs --update --report backend/coverage/light/coverage-final.json --report backend/coverage/workers/coverage-final.json --report frontend/coverage/coverage-final.json",
    "coverage:test-gate": "node --test scripts/check-coverage-verdict.mjs",
    "deploy:backend": "npm --prefix backend run deploy",
    "deploy:frontend": "npm --prefix frontend run deploy",
    "deploy:all": "npm run deploy:frontend && npm run deploy:backend",
    "db:reset": "npm --prefix backend run db:reset",
    "db:reset:remote:DANGER": "npm --prefix backend run db:reset:remote:DANGER",
    "db:reset:local": "npm --prefix backend run db:reset:local",
    "db:migrate": "npm --prefix backend run db:migrate",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint",
    "lint:update": "npm --prefix backend run lint:update && npm --prefix frontend run lint:update",
    "explain": "node scripts/explain.mjs",
    "explain:check": "node scripts/explain.mjs --check",
    "explain:write": "node scripts/explain.mjs --write",
    "explain:check-docs": "node scripts/explain.mjs --check-docs",
    "explain:test": "node --test scripts/explain.test.mjs"
  }
}
